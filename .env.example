# Control Plane
CP_LISTEN_ADDR=:8080
CP_DATABASE_URL=postgres://vibedeploy:vibedeploy@postgres:5432/vibedeploy?sslmode=disable
CP_PUBLIC_BASE_URL=http://localhost:8080
CP_APP_BASE_DOMAIN=lab.localhost

# Object storage (MinIO)
CP_S3_ENDPOINT=minio:9000
CP_S3_REGION=us-east-1
CP_S3_ACCESS_KEY=vibedeploy
CP_S3_SECRET_KEY=vibedeploypw
CP_S3_BUCKET_SOURCE=vibedeploy-source
CP_S3_USE_SSL=false

# Hostname baked into the presigned URLs the Skill consumes. Must be reachable
# from the client (laptop / CI). For local dev on the same machine the host
# publishes :9000 → localhost:9000. For an ECS deploy install-platform.sh sets
# this to <platform-ip>:9000.
CP_S3_PUBLIC_ENDPOINT=localhost:9000
CP_S3_PUBLIC_USE_SSL=false

# Image registry hostname. Must be reachable by:
#   - the host docker daemon (Build Service's `docker push` goes through the mounted
#     /var/run/docker.sock — the daemon resolves names, NOT the container).
#   - K3s containerd on every node.
#
# Mac/Win Docker Desktop: host.docker.internal is the host from inside the VM.
# Linux production:       use the platform node's IP (install-platform.sh sets this).
CP_REGISTRY_HOST=host.docker.internal:5001
CP_REGISTRY_HOST_FROM_K3D=host.k3d.internal:5001

# Encryption KEK (32 bytes, base64). For dev only. Replace in prod.
CP_KEK_BASE64=ZGV2LWtleS0zMi1ieXRlcy1mb3ItYWVzLWdjbS1leGFtcGxl

# Keycloak (optional; if empty, only Deploy Tokens accepted).
#
# Minimum to enable JWT-bearer auth (CLI hitting /v1 with `Authorization: Bearer <JWT>`):
#   CP_KC_ISSUER     — Realm issuer URL, e.g. https://kc.example.com/realms/lb
#   CP_KC_JWKS_URL   — JWKS endpoint, e.g. <issuer>/protocol/openid-connect/certs
#   CP_KC_AUDIENCE   — Audience claim to require (leave empty to skip the check)
#
# Plus, for the Web UI's "Sign in with Keycloak" button:
#   CP_KC_AUTHORIZATION_URL — <issuer>/protocol/openid-connect/auth
#   CP_KC_TOKEN_URL         — <issuer>/protocol/openid-connect/token
#   CP_KC_CLIENT_ID         — confidential client name (e.g. vibedeploy-proxy)
#   CP_KC_CLIENT_SECRET     — its secret
#   CP_KC_REDIRECT_URL      — Use the Web UI's public origin, not the API port.
#                             Local dev: http://localhost:5173/v1/auth/oidc-callback
#                             Prod:       http://<host>:5173/v1/auth/oidc-callback
#                             web nginx proxies /v1/* through to control-plane,
#                             so the browser stays on a single origin for the
#                             whole OIDC round-trip. Keycloak's redirect URI
#                             whitelist in its client must include this URL.
CP_KC_ISSUER=
CP_KC_JWKS_URL=
# Audience check is optional. Most Keycloak setups don't put the resource
# server name in `aud` without a custom mapper — leaving this empty skips the
# check entirely (issuer + signature verification is still enforced). Fill in
# only after adding an "Audience" protocol mapper that injects this value.
CP_KC_AUDIENCE=
CP_KC_AUTHORIZATION_URL=
CP_KC_TOKEN_URL=
CP_KC_CLIENT_ID=
CP_KC_CLIENT_SECRET=
CP_KC_REDIRECT_URL=

# Bootstrap: a dev deploy-token printed on first start so the Skill can talk to us.
# Leave empty to auto-generate; check control-plane logs.
CP_DEV_BOOTSTRAP_TOKEN=

# Kubernetes
CP_KUBECONFIG=/root/.kube/config
CP_K8S_INGRESS_CLASS=traefik

# Build Service
BS_DATABASE_URL=${CP_DATABASE_URL}
BS_S3_ENDPOINT=${CP_S3_ENDPOINT}
BS_S3_ACCESS_KEY=${CP_S3_ACCESS_KEY}
BS_S3_SECRET_KEY=${CP_S3_SECRET_KEY}
BS_S3_BUCKET_SOURCE=${CP_S3_BUCKET_SOURCE}
BS_S3_USE_SSL=false
BS_REGISTRY_HOST=${CP_REGISTRY_HOST}
BS_WORK_DIR=/var/lib/vibedeploy/build
BS_POLL_INTERVAL=2s
BS_MAX_CONCURRENT=2
